msgid "Configuration file not found: {path}"
msgstr "कॉन्फ़िगरेशन फ़ाइल नहीं मिली: {path}"

#, python-brace-format
msgid "Missing required field '{field}' in {path}"
msgstr "{path} में आवश्यक फ़ील्ड '{field}' मौजूद नहीं है"

#, python-brace-format
msgid "Invalid repository '{repo}', expected 'owner/name'"
msgstr "अमान्य रिपॉजिटरी '{repo}', 'owner/name' अपेक्षित था"

#, python-brace-format
msgid "{repo}: error: {error}"
msgstr "{repo}: त्रुटि: {error}"

#, python-brace-format
msgid "{repo}: {pull_requests}, {issues}"
